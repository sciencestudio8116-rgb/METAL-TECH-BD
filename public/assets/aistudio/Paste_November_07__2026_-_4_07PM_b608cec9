-- ==============================================================================
-- 8. REALTIME REPLICATION CONFIGURATION (SAFE IDEMPOTENT LOOP)
-- ==============================================================================
DO $$
DECLARE
  tbl_name text;
  tables_to_add text[] := ARRAY[
    'site_metadata',
    'navigation_menus',
    'process_cards',
    'capability_cards',
    'market_cards',
    'videos',
    'alloys',
    'blog_posts',
    'case_studies',
    'faqs',
    'downloads',
    'content_items',
    'rfq_leads',
    'admin_action_logs'
  ];
BEGIN
  FOREACH tbl_name IN ARRAY tables_to_add LOOP
    IF NOT EXISTS (
      SELECT 1 FROM pg_publication_tables 
      WHERE pubname = 'supabase_realtime' 
        AND schemaname = 'public' 
        AND tablename = tbl_name
    ) THEN
      EXECUTE format('ALTER PUBLICATION supabase_realtime ADD TABLE public.%I;', tbl_name);
    END IF;
  END LOOP;
END $$;
২. আর্কিটেকচার এবং কানেকশন চেকলিস্ট (Architecture Checklist)
কম্পোনেন্ট	স্ট্যাটাস	সুবিধা ও ভূমিকা
rfq_leads	✅ সক্রিয়	ওয়েবসাইট ভিজিটররা কোনো লগইন ছাড়াই আরএফকিউ সাবমিট করতে পারবেন (Public Insert পলিসি)। অ্যাডমিন প্যানেল স্বয়ংক্রিয়ভাবে নোটিফিকেশন ব্যাজে নতুন লিড দেখতে পাবে এবং CSV এক্সপোর্ট করতে পারবে।
site_metadata	✅ সক্রিয়	ফোন নম্বর, ইমেইল, গাজীপুর প্ল্যান্ট অ্যাড্রেস ও ঢাকা হেডকোয়ার্টার ঠিকানা ক্লাউড থেকে নিয়ন্ত্রিত হবে। অ্যাডমিন পরিবর্তন করলেই পুরো ওয়েবসাইটে সাথে সাথে আপডেট হবে।
admin_action_logs	✅ সক্রিয়	অ্যাডমিন প্যানেল থেকে যেকোনো কনটেন্ট পরিবর্তন, মোছা বা CSV এক্সপোর্টের অডিট ট্রেইল টাইমস্ট্যাম্পসহ সংরক্ষিত থাকবে।
অটোমেটিক ট্রিগার	✅ সক্রিয়	handle_updated_at() ফাংশনের মাধ্যমে যেকোনো ডেটা আপডেট হলে তার updated_at কলামে স্বয়ংক্রিয়ভাবে বর্তমান সময় রেকর্ড হয়ে যাবে।
Idempotent RLS	✅ সক্রিয়	DROP POLICY IF EXISTS যুক্ত থাকার কারণে আপনি এই স্ক্রিপ্ট যতবার খুশি রান করলেও কোনো "policy already exists" এরর আসবে না।
metaltek-media Storage	✅ সক্রিয়	ছবি ও ভিডিও আপলোডের জন্য পাবলিক বাকেট ও সিকিউর পলিসি স্বয়ংক্রিয়ভাবে তৈরি হবে।
Realtime Publication	✅ সক্রিয়	supabase_realtime পাবলিকেশনের কারণে অ্যাডমিন প্যানেলে করা যেকোনো পরিবর্তন ব্যবহারকারীর ব্রাউজারে রিফ্রেশ ছাড়াই লাইভ সিঙ্ক হবে।
